#include <iostream>
#include <string>
#include<ctime>
using namespace std;
template <typename T>
class Hashtable
{
public:
    int capacity;
    T *table;
    int n;
    Hashtable(int cap)
    {
        n = 0;
        capacity = cap;
        table = new T[capacity];
        for (int i = 0; i < capacity; i++)
        {
            table[i] = "0";
        }
    }
    int hash(T value_index)
    {
        int sum = 0;
        for (int i = 0; i < value_index.length(); i++)
        {

            sum += value_index[i];
        }
        cout << "the sum of your string is :" << sum << endl;
        return sum % capacity;
    }
    void insert(T value)
    {
        int index = hash(value);
        for (int i = 0; i < capacity; i++)
        {
            if (table[index] == "0" || table[index] == "-1")
            {
                table[index] = value;
                return;
            }
            else
            {
                int newindex = index + 1;
                table[newindex] = value;
                return;
            }
        }
        cout << "Table full, cannot insert " << value << endl;
    }
    bool search(T name)
    {
        bool found = false;
        int index = hash(name);
        for (int i = 0; i < capacity; i++)
        {
            if (table[index] == name)
            {
                found = true;
            }
            else
            {
                found = false;
            }
        }
        return found;
    }
    void remove(T name)
    {
        int index = hash(name);
        for (int i = 0; i < capacity; i++)
        {
            if (table[index] == "0")
            {
                cout << "Value not found\n";
                return;
            }
            if (table[index] == name)
            {
                table[index] = "0";
                return;
            }
        }
    }


    void display()
    {
        for (int i = 0; i < capacity; i++)
        {

            if (table[i] != "0")
                cout << table[i] << " " << endl;
        }
    }
    void displaycontents()

    {
        for (int i = 0; i < capacity; i++)
        {
            cout << table[i] << " ";
        }
        cout << endl;
        for (int i = 0; i < capacity; i++)
        {

            if (table[i] != "0")
                cout << table[i] << " " << endl;
        }
    }
};
int main()
{
    Hashtable<string> h(20);
    cout << endl;
    cout << "the mod of your string after calculation is : " << h.hash("ali") << endl;
    h.insert("moawiz");
    h.insert("ali");
    h.insert("sipra");
    h.insert("rehan");

    h.display();
    cout << endl;
    cout << "your name is " << h.search("moawiz") << endl;
    cout << "your name is " << h.search("ali") << endl;
    cout << "your name is " << h.search("rehan") << endl;
    cout << endl;
    cout << "the contents are " << endl;
    h.displaycontents();
    cout << endl;
    cout << "removing " << endl;
    h.remove("moawiz");
    cout << "after removal" << endl;
    h.display();
    cout<<"Integers Hashtable"<<endl;


    return 0;
}
